{
  "name": "hollow-parish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based third-person survival shooter prototype built with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/three": "^0.181.0",
    "eslint": "^10.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.4"
  }
}
